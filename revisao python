n1 = 0
n2 = 0

print("Digite uma operação")
print("1 - soma")
print("2 - subtração")
print("3 - Multiplicação")
print("4 - Divisão")

operacao = input("escolha a aporação")

n1 = float(input("Digite o número 1:"))
n2 = float(input("Digite o número 2:"))

if operacao == "1":
    resultado = n1 + n2
    print(resultado)
elif operacao == "2":
    resultado = n1 - n2
    print(resultado)
elif operacao == "3":
    resultado = n1 * n2
    print(resultado)
elif operacao == "4":
    resultado = n1 / n2
    print(resultado)

